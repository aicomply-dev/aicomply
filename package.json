{
  "name": "ai-act-platform",
  "version": "0.1.0",
  "description": "Open-source platform for understanding, assessing, implementing, and delivering EU AI Act compliance",
  "author": {
    "name": "Daniel Minda",
    "url": "https://www.linkedin.com/in/danielm7"
  },
  "license": "MIT",
  "private": false,
  "scripts": {
    "dev": "next dev --turbopack -H 0.0.0.0",
    "build": "next build",
    "build:standalone": "next build && npm run postbuild",
    "postbuild": "mkdir -p .next/standalone/.next/static/chunks .next/standalone/.next/static/css .next/standalone/.next/static/media .next/standalone/.next/server && cp -r .next/static/chunks/* .next/standalone/.next/static/chunks/ 2>/dev/null || true && cp -r .next/static/css/* .next/standalone/.next/static/css/ 2>/dev/null || true && cp -r .next/static/media/* .next/standalone/.next/static/media/ 2>/dev/null || true && cp -r .next/server/* .next/standalone/.next/server/ 2>/dev/null || true && cp -r public .next/standalone/ 2>/dev/null || true",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun scripts/seed-database.ts",
    "db:export": "bun scripts/export-database.ts",
    "db:import": "bun scripts/import-database.ts",
    "db:reset": "rm -f sqlite.db && bun run db:migrate && bun run db:seed"
  },
